# Forking this? Point the three URLs at YOUR resume-agent + site, and set the key.
# The defaults below are the reference instance (yuens.me) — override them.

# ── Client (build-time, PUBLIC — inlined into the bundle by Vite) ──
# Base URL of your deployed resume-agent backend.
VITE_API_BASE=https://agent.yuens.me
# Your canonical site URL — drives <link rel="canonical">, og:url, and the agent-menu QR.
VITE_SITE_URL=https://www.yuens.me

# ── Server (runtime, SECRET — never sent to the browser) ──
# Backend base the /api/resume proxy + machine surface read from (usually = VITE_API_BASE).
RESUME_API_BASE=https://agent.yuens.me
# Your resume-agent API_KEY. /resume is gated (AUTH_MODE=key); the proxy attaches this
# as `Authorization: Bearer <key>` server-side. Set it in your host's secrets, never commit it.
RESUME_AGENT_API_KEY=
# Port the Node server listens on (most hosts inject PORT automatically).
PORT=8787
