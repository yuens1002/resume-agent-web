# ── Client (build-time, PUBLIC — inlined into the bundle by Vite) ──
# Base URL of the deployed resume-agent backend.
VITE_API_BASE=https://agent.yuens.me
# Canonical site URL — the agent-menu QR encodes this so a phone scan opens the chat.
VITE_SITE_URL=https://yuens.me

# ── Server (runtime, SECRET — never sent to the browser) ──
# Backend base the /api/resume proxy forwards to (usually same as VITE_API_BASE).
RESUME_API_BASE=https://agent.yuens.me
# resume-agent's API_KEY. /resume is gated (AUTH_MODE=key); the proxy attaches this
# as `Authorization: Bearer <key>` server-side. Set this in Railway, never commit it.
RESUME_AGENT_API_KEY=
# Port the Node server listens on (Railway injects PORT automatically).
PORT=8787
